# Пример: nginx на ВМ → proxy на Docker (доки) на 127.0.0.1:8080
#
# На сервере часто НЕТ клона репозитория — проще создать файл так (Ubuntu/Debian):
#
#   sudo apt update && sudo apt install -y nginx
#   sudo tee /etc/nginx/sites-available/docs.example.com <<'EOF'
#   server {
#       listen 80;
#       listen [::]:80;
#       server_name docs.example.com;
#       location / {
#           proxy_pass http://127.0.0.1:8080;
#           proxy_http_version 1.1;
#           proxy_set_header Host $host;
#           proxy_set_header X-Real-IP $remote_addr;
#           proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#           proxy_set_header X-Forwarded-Proto $scheme;
#       }
#   }
#   EOF
#   sudo ln -sf /etc/nginx/sites-available/docs.example.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Если каталога sites-available нет — значит nginx не установлен или другой дистрибутив;
# после apt install nginx пакета на Ubuntu/Debian каталоги появятся.
#
# DNS: A docs.example.com → IP этой машины.

server {
    listen 80;
    listen [::]:80;
    server_name docs.example.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
